APP_ENV=production
APP_NAME=LiftLog
DATABASE_URL=sqlite:////var/lib/liftlog/liftlog.db
API_PREFIX=/api/v1

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

LOG_LEVEL=INFO
LOG_TO_FILE=false
UVICORN_ACCESS_LOG=false
CORS_ORIGINS=https://liftlog.example.com
SEED_DEMO_DATA=false